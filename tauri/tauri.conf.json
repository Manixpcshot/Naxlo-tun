{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "naxlo",
  "version": "1.7.0",
  "identifier": "net.naxlo.rust",
  "build": {
    "beforeBuildCommand": "npm run build:tauri-ui",
    "beforeDevCommand": "npm run dev:tauri-ui",
    "devUrl": "http://localhost:5199",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Naxlo",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Persian VLESS client (Rust edition)",
    "longDescription": "Naxlo is a Persian (RTL), dark-themed VLESS subscription client. The Rust edition runs the official Xray core as a local proxy on Windows, Linux and macOS.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
